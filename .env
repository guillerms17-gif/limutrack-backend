# ─── LimuTrack Backend — Variables de entorno ───────────────
# Copia este archivo como .env y rellena los valores

# Puerto del servidor (por defecto 3001)
PORT=3001

# Secreto para firmar los JWT — cámbialo por algo largo y aleatorio
JWT_SECRET=pon_aqui_una_frase_larga_y_secreta_cualquiera

# ID de tu finca (sin espacios)
FINCA_ID=finca_el_roble

# MQTT — déjalo vacío por ahora, se activa cuando tengas el collar físico
# Para HiveMQ Cloud sería: mqtts://xxxx.s2.eu.hivemq.cloud:8883
MQTT_URL=
MQTT_USER=
MQTT_PASS=
